const FOG_KEY_PREFIX = 'mn_fog_v2';
const LEGACY_FOG_KEY_PREFIX = 'mn_fog_v1';
const MIGRATE_LEGACY_FOG = false;

function clamp(value, min, max) {
  return Math.min(Math.max(value, min), max);
}

function isMobileGameplayDevice() {
  const hasTouch = navigator.maxTouchPoints > 0;
  const narrowScreen =
    Math.min(window.innerWidth || 9999, window.innerHeight || 9999) <= 920;

  return hasTouch && narrowScreen;
}

function getFogKey(cityId, playerId, gridSize) {
  return `${FOG_KEY_PREFIX}_${cityId}_${playerId}_${gridSize}`;
}

function getLegacyFogKey(cityId, playerId) {
  return `${LEGACY_FOG_KEY_PREFIX}_${cityId}_${playerId}`;
}

function parseCellKey(key) {
  if (typeof key !== 'string') return null;

  const separatorIndex = key.indexOf(':');
  if (separatorIndex <= 0) return null;

  const x = Number(key.slice(0, separatorIndex));
  const y = Number(key.slice(separatorIndex + 1));

  if (!Number.isFinite(x) || !Number.isFinite(y)) return null;

  return {
    x: Math.round(x),
    y: Math.round(y),
  };
}

function cellKey(x, y) {
  return `${x}:${y}`;
}

function normalizeCellList(value, gridSize) {
  const source = Array.isArray(value)
    ? value
    : Array.isArray(value?.cells)
      ? value.cells
      : [];

  const cells = new Set();
  const points = [];

  for (const item of source) {
    const point = parseCellKey(item);
    if (!point) continue;

    const x = clamp(point.x, 0, gridSize);
    const y = clamp(point.y, 0, gridSize);
    const key = cellKey(x, y);

    if (cells.has(key)) continue;

    cells.add(key);
    points.push({ x, y });
  }

  return { cells, points };
}

function loadRevealedState(cityId, playerId, gridSize) {
  const key = getFogKey(cityId, playerId, gridSize);

  try {
    const raw = localStorage.getItem(key);
    if (raw) {
      return normalizeCellList(JSON.parse(raw), gridSize);
    }
  } catch {}

  /*
    Старый ключ v1 специально не подтягивается автоматически.
    Именно старый раздутый кэш чаще всего душит Запорожье после долгих тестов.
    Если понадобится миграция старого прогресса — поставь MIGRATE_LEGACY_FOG = true.
  */
  if (MIGRATE_LEGACY_FOG) {
    try {
      const raw = localStorage.getItem(getLegacyFogKey(cityId, playerId));
      if (raw) {
        return normalizeCellList(JSON.parse(raw), gridSize);
      }
    } catch {}
  }

  return {
    cells: new Set(),
    points: [],
  };
}

function saveRevealedCells(cityId, playerId, gridSize, cells) {
  try {
    localStorage.setItem(
      getFogKey(cityId, playerId, gridSize),
      JSON.stringify({
        version: 2,
        gridSize,
        cells: [...cells],
      })
    );
  } catch {}
}

function addRevealedCell(state, x, y) {
  const key = cellKey(x, y);

  if (state.cells.has(key)) {
    return false;
  }

  state.cells.add(key);
  state.points.push({ x, y });
  return true;
}

function revealAround(state, playerX, playerY, gridSize, radius) {
  const cx = Math.round((playerX / 100) * gridSize);
  const cy = Math.round((playerY / 100) * gridSize);
  const radiusSq = radius * radius;
  let changed = false;

  for (let y = cy - radius; y <= cy + radius; y += 1) {
    if (y < 0 || y > gridSize) continue;

    for (let x = cx - radius; x <= cx + radius; x += 1) {
      if (x < 0 || x > gridSize) continue;

      const dx = x - cx;
      const dy = y - cy;

      if ((dx * dx) + (dy * dy) > radiusSq) continue;

      if (addRevealedCell(state, x, y)) {
        changed = true;
      }
    }
  }

  return changed;
}

function createCanvas(width = 1, height = 1) {
  const canvas = document.createElement('canvas');
  canvas.width = width;
  canvas.height = height;
  return canvas;
}

function getCanvasContext(canvas) {
  return canvas.getContext('2d', {
    alpha: true,
    desynchronized: true,
  }) || canvas.getContext('2d');
}

function createRadialBrush(radius, stops) {
  const size = Math.max(2, Math.ceil(radius * 2) + 2);
  const brush = createCanvas(size, size);
  const brushCtx = getCanvasContext(brush);

  if (!brushCtx) return null;

  const center = size / 2;
  const gradient = brushCtx.createRadialGradient(
    center,
    center,
    0,
    center,
    center,
    radius
  );

  for (const [offset, color] of stops) {
    gradient.addColorStop(offset, color);
  }

  brushCtx.clearRect(0, 0, size, size);
  brushCtx.fillStyle = gradient;
  brushCtx.beginPath();
  brushCtx.arc(center, center, radius, 0, Math.PI * 2);
  brushCtx.fill();

  return brush;
}

export function enableFogOfWar({
  stage,
  viewport,
  playerMarker,
  playerPosition,
  cityId,
  playerId,
}) {
  if (!stage || !viewport || !playerMarker || !playerPosition) return null;

  const mobile = isMobileGameplayDevice();

  /*
    Оптимизация для тяжёлых городов типа Запорожья:
    - все уже открытые клетки рисуются в memoryCanvas только при изменении/resize;
    - на мобилке сетка и внутреннее разрешение canvas ниже, чтобы Telegram WebView
      не стопорил кадры во время движения;
    - основной canvas обновляется реже, движение карты остаётся 60fps;
    - localStorage сохраняется с debounce, а не на каждый шаг;
    - старый v1-кэш не читается, чтобы не тащить раздутые данные из старой версии.
  */
  const GRID_SIZE = mobile ? 24 : 46;
  const REVEAL_RADIUS = mobile ? 2 : 4;
  const VISION_RADIUS = mobile ? 16 : 15;
  const MOVE_THRESHOLD = mobile ? 0.95 : 0.18;
  const TICK_INTERVAL_MS = mobile ? 220 : 0;
  const CANVAS_RESOLUTION_SCALE = mobile ? 0.34 : 1;
  const SAVE_DEBOUNCE_MS = mobile ? 4200 : 700;

  const canvas = createCanvas();
  canvas.className = 'fog-of-war-canvas';
  canvas.style.pointerEvents = 'none';
  canvas.style.contain = 'strict';
  canvas.style.willChange = 'auto';
  viewport.appendChild(canvas);

  const ctx = getCanvasContext(canvas);
  const memoryCanvas = createCanvas();
  const memoryCtx = getCanvasContext(memoryCanvas);

  if (!ctx || !memoryCtx) {
    canvas.remove();
    return null;
  }

  const revealedState = loadRevealedState(cityId, playerId, GRID_SIZE);

  let animationId = null;
  let timerId = null;
  let saveTimerId = null;
  let resizeTimerId = null;
  let destroyed = false;
  let lastX = null;
  let lastY = null;
  let lastCanvasWidth = 0;
  let lastCanvasHeight = 0;
  let savePending = false;
  let memoryDirty = true;
  let revealedBrush = null;
  let liveBrush = null;
  let cloudBrush = null;

  function scheduleSave(force = false) {
    if (force || !SAVE_DEBOUNCE_MS) {
      savePending = false;
      window.clearTimeout(saveTimerId);
      saveTimerId = null;
      saveRevealedCells(cityId, playerId, GRID_SIZE, revealedState.cells);
      return;
    }

    savePending = true;

    if (saveTimerId) return;

    saveTimerId = window.setTimeout(() => {
      saveTimerId = null;

      if (destroyed || !savePending) return;

      savePending = false;
      saveRevealedCells(cityId, playerId, GRID_SIZE, revealedState.cells);
    }, SAVE_DEBOUNCE_MS);
  }

  function rebuildBrushes(width, height) {
    const cellW = width / GRID_SIZE;
    const cellH = height / GRID_SIZE;
    const revealedRadius = Math.max(cellW, cellH) * (mobile ? 2.0 : 2.2);
    const liveRadius = Math.max(width, height) * (VISION_RADIUS / 100);
    const cloudRadius = Math.max(width, height) * 0.45;

    revealedBrush = createRadialBrush(revealedRadius, [
      [0, 'rgba(255,255,255,0.95)'],
      [0.55, 'rgba(255,255,255,0.48)'],
      [1, 'rgba(255,255,255,0)'],
    ]);

    liveBrush = createRadialBrush(liveRadius, [
      [0, 'rgba(255,255,255,1)'],
      [0.45, 'rgba(255,255,255,0.85)'],
      [0.75, 'rgba(255,255,255,0.35)'],
      [1, 'rgba(255,255,255,0)'],
    ]);

    cloudBrush = mobile
      ? null
      : createRadialBrush(cloudRadius, [
          [0, 'rgba(255,255,255,0)'],
          [0.55, 'rgba(160,180,200,0.06)'],
          [1, 'rgba(210,225,240,0.14)'],
        ]);
  }

  function resizeCanvas() {
    const layoutWidth = Number(viewport.clientWidth || viewport.offsetWidth || 0);
    const layoutHeight = Number(viewport.clientHeight || viewport.offsetHeight || 0);
    const rect = (!layoutWidth || !layoutHeight) ? viewport.getBoundingClientRect() : null;

    const rawWidth = layoutWidth || Number(rect?.width) || 1;
    const rawHeight = layoutHeight || Number(rect?.height) || 1;

    const width = Math.max(1, Math.round(rawWidth * CANVAS_RESOLUTION_SCALE));
    const height = Math.max(1, Math.round(rawHeight * CANVAS_RESOLUTION_SCALE));

    if (width === lastCanvasWidth && height === lastCanvasHeight) {
      return false;
    }

    canvas.width = width;
    canvas.height = height;
    memoryCanvas.width = width;
    memoryCanvas.height = height;

    lastCanvasWidth = width;
    lastCanvasHeight = height;
    memoryDirty = true;

    rebuildBrushes(width, height);
    return true;
  }

  function drawMemoryMask() {
    if (!memoryDirty) return;

    memoryDirty = false;

    const width = memoryCanvas.width;
    const height = memoryCanvas.height;
    const cellW = width / GRID_SIZE;
    const cellH = height / GRID_SIZE;

    memoryCtx.clearRect(0, 0, width, height);

    if (!revealedBrush) return;

    const brushW = revealedBrush.width;
    const brushH = revealedBrush.height;
    const halfBrushW = brushW / 2;
    const halfBrushH = brushH / 2;

    memoryCtx.globalCompositeOperation = 'source-over';
    memoryCtx.imageSmoothingEnabled = true;

    for (const point of revealedState.points) {
      const px = point.x * cellW;
      const py = point.y * cellH;

      memoryCtx.drawImage(
        revealedBrush,
        px - halfBrushW,
        py - halfBrushH,
        brushW,
        brushH
      );
    }
  }

  function drawBrushDestinationOut(brush, x, y) {
    if (!brush) return;

    ctx.drawImage(
      brush,
      x - (brush.width / 2),
      y - (brush.height / 2),
      brush.width,
      brush.height
    );
  }

  function drawFog() {
    resizeCanvas();
    drawMemoryMask();

    const width = canvas.width;
    const height = canvas.height;

    const playerX = clamp(Number(playerPosition.x) || 50, 0, 100);
    const playerY = clamp(Number(playerPosition.y) || 50, 0, 100);
    const px = (playerX / 100) * width;
    const py = (playerY / 100) * height;

    ctx.clearRect(0, 0, width, height);

    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = mobile ? 'rgba(5, 8, 12, 0.82)' : 'rgba(5, 8, 12, 0.88)';
    ctx.fillRect(0, 0, width, height);

    ctx.globalCompositeOperation = 'destination-out';
    ctx.drawImage(memoryCanvas, 0, 0);
    drawBrushDestinationOut(liveBrush, px, py);

    if (cloudBrush) {
      ctx.globalCompositeOperation = 'source-over';
      drawBrushDestinationOut(cloudBrush, px, py);
    }

    ctx.globalCompositeOperation = 'source-over';
  }

  function runTick() {
    if (destroyed) return;

    const x = clamp(Number(playerPosition.x) || 50, 0, 100);
    const y = clamp(Number(playerPosition.y) || 50, 0, 100);

    const moved =
      lastX === null ||
      lastY === null ||
      Math.hypot(x - lastX, y - lastY) >= MOVE_THRESHOLD;

    if (!moved) return;

    const changed = revealAround(
      revealedState,
      x,
      y,
      GRID_SIZE,
      REVEAL_RADIUS
    );

    if (changed) {
      memoryDirty = true;
      scheduleSave(false);
    }

    drawFog();

    lastX = x;
    lastY = y;
  }

  function tick() {
    if (destroyed) return;

    runTick();

    if (TICK_INTERVAL_MS > 0) {
      timerId = window.setTimeout(tick, TICK_INTERVAL_MS);
      return;
    }

    animationId = requestAnimationFrame(tick);
  }

  function handleResize() {
    if (destroyed) return;

    window.clearTimeout(resizeTimerId);
    resizeTimerId = window.setTimeout(() => {
      if (destroyed) return;
      memoryDirty = true;
      drawFog();
    }, 80);
  }

  function handleVisibilityChange() {
    if (document.visibilityState === 'hidden' && savePending) {
      scheduleSave(true);
    }
  }

  const initiallyChanged = revealAround(
    revealedState,
    Number(playerPosition.x) || 50,
    Number(playerPosition.y) || 50,
    GRID_SIZE,
    REVEAL_RADIUS
  );

  if (initiallyChanged) {
    memoryDirty = true;
    scheduleSave(false);
  }

  window.addEventListener('resize', handleResize, { passive: true });
  document.addEventListener('visibilitychange', handleVisibilityChange);

  drawFog();
  tick();

  return () => {
    destroyed = true;

    if (animationId) cancelAnimationFrame(animationId);

    window.clearTimeout(timerId);
    window.clearTimeout(saveTimerId);
    window.clearTimeout(resizeTimerId);

    window.removeEventListener('resize', handleResize);
    document.removeEventListener('visibilitychange', handleVisibilityChange);

    if (savePending) {
      saveRevealedCells(cityId, playerId, GRID_SIZE, revealedState.cells);
    }

    canvas.remove();
  };
}
